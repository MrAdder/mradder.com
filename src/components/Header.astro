---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/"><span class="prompt-user">mradder</span><span class="prompt-sep">@web:~$</span></a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/danielgreen89" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Connect on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
					><path
						fill="currentColor"
						d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM5 13.5H2.5v-7H5zM3.75 5.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zM13.5 13.5H11v-3.75c0-1-.5-1.75-1.5-1.75-.75 0-1.25.5-1.5 1-.05.15-.06.35-.06.55v3.95H5.5s.03-6.4 0-7H8v1.05c.3-.5.95-1.2 2.25-1.2 1.65 0 3.25 1 3.25 3.35z"
					></path></svg
				>
			</a>
			<a href="#" data-eu="30neergd" data-ed="moc.liamg" class="email-link">
				<span class="sr-only">Email Daniel</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
					><path
						fill="currentColor"
						d="M1.5 3A1.5 1.5 0 0 0 0 4.5v7A1.5 1.5 0 0 0 1.5 13h13a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 14.5 3zM1 4.943l6.858 4.286a.5.5 0 0 0 .284 0L15 4.943V11.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5zm.5-1.443h13a.5.5 0 0 1 .488.392L8 8.443 1.012 3.892A.5.5 0 0 1 1.5 3.5z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--bg-elevated));
		border-bottom: 1px solid rgb(var(--border));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		text-decoration: none;
		font-family: var(--font-mono);
	}
	.prompt-user {
		color: rgb(var(--fg));
	}
	.prompt-sep {
		color: var(--accent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--fg-muted));
		font-family: var(--font-mono);
		font-size: 0.9em;
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a:hover {
		color: rgb(var(--fg));
	}
	nav a.active {
		color: rgb(var(--fg));
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links a {
		padding: 0.5em;
		color: rgb(var(--fg-muted));
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
<script>
	function decodeEmailLinks() {
		document.querySelectorAll<HTMLAnchorElement>('a[data-eu][data-ed]').forEach((el) => {
			const user = (el.dataset.eu ?? '').split('').reverse().join('');
			const domain = (el.dataset.ed ?? '').split('').reverse().join('');
			const email = `${user}@${domain}`;
			el.href = `mailto:${email}`;
			if (el.dataset.reveal === '1') {
				el.textContent = email;
			}
		});
	}
	decodeEmailLinks();
</script>
