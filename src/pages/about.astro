---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const skills = [
	{
		label: 'Operating Systems',
		items: ['Windows client & server', 'Linux command line', 'Linux user & permission management'],
	},
	{
		label: 'Identity & Security',
		items: [
			'Active Directory user & group administration',
			'Microsoft Entra ID concepts',
			'Microsoft 365 security & compliance fundamentals',
		],
	},
	{
		label: 'Productivity Platforms',
		items: ['Microsoft 365 administration', 'End-user support'],
	},
	{
		label: 'Networking',
		items: ['TCP/IP', 'IP addressing & subnetting', 'DHCP & DNS basics', 'UniFi configuration & monitoring'],
	},
	{
		label: 'Virtualisation',
		items: ['Virtual machines', 'LXC containers', 'Backup & recovery testing'],
	},
	{
		label: 'IT Service Management',
		items: ['Ticketing systems', 'Incident triage', 'Escalation procedures', 'Documentation & knowledge base articles'],
	},
	{
		label: 'Professional Skills',
		items: ['Customer service', 'Team leadership', 'Training & onboarding', 'Working under pressure'],
	},
	{
		label: 'Development & Open Source',
		items: [
			'Node.js',
			'JavaScript',
			'Event-driven automation',
			'PHP',
			'Laravel',
			'MySQL',
			'Filament',
			'React',
			'TypeScript',
			'Python / Discord.py',
			'Git & GitHub',
			'CI/CD (GitHub Actions)',
			'Automated testing',
		],
	},
];

const projects = [
	{
		title: 'Filament Logger (open source package)',
		href: 'https://github.com/MrAdder/filament-logger',
		description:
			'Maintain a published Laravel/Filament package for audit logging, activity tracking, and admin-panel dashboards — 25+ GitHub stars and available on Packagist. Runs its own CI pipeline with automated tests, PHPStan static analysis, and a SonarCloud quality gate.',
	},
	{
		title: 'VATSIM UK — air traffic controller & contributor',
		href: 'https://www.vatsim.uk/',
		description:
			'S1-rated controller and code contributor for VATSIM UK, a live, community-run online air traffic control and flight simulation network, contributing to the controller tooling used across the organisation.',
	},
	{
		title: 'mradder.com (this site)',
		href: 'https://mradder.com',
		description:
			'Designed and built this site with Astro, including a GitHub Actions CI/CD pipeline (type-checking, automated Playwright tests, deploy on merge), Dependabot-managed dependency updates, SEO (structured data, sitemap, Open Graph), and hardening against automated scraping.',
	},
	{
		title: 'Home Lab Environment (Windows & Linux)',
		description:
			'Designed, deployed, and maintain a virtualised lab of Windows and Linux systems using virtual machines and LXC containers. Configure systems, manage user accounts and permissions, troubleshoot faults across operating systems, run recovery tests to validate backups, and document every change and fix so it can be repeated.',
	},
	{
		title: 'Networking & Infrastructure',
		description:
			'Implemented and manage a UniFi-based home network, configuring switches, access points, and gateway settings. Monitor connectivity and performance, and diagnose hardware and network faults using core networking principles.',
	},
	{
		title: 'Software Development & Automation',
		description:
			'Built custom Discord bots using Node.js, with event-driven logic, command handling, and third-party integrations. Solved implementation problems independently using official documentation and technical communities.',
	},
];

const experience = [
	{
		role: 'Shift Leader',
		org: 'Tesco',
		dates: 'April 2021 – December 2025',
		description:
			'Led shifts across a store team of around 18 colleagues, acting as first point of contact for operational and system issues, diagnosing problems and coordinating fixes under time pressure. Supported colleagues with system and process queries, followed escalation procedures when issues needed specialist teams, and used internal tools for reporting, compliance, and audit, keeping records accurate and complete.',
	},
	{
		role: 'Supervisor',
		org: "McColl's Retail Group",
		dates: 'August 2018 – November 2020',
		description:
			'Resolved system-related and customer issues to keep daily store operations running, onboarded and trained new colleagues on systems and procedures, and enforced security standards and data handling requirements across the team.',
	},
	{
		role: 'Global Administrator (Paid)',
		org: 'Twitch',
		dates: 'September 2013 – January 2015',
		description:
			'Moderated large global online communities using administrative and automation tools. Investigated incidents, enforced platform policies, documented actions for traceability, and handled escalations across multiple regions and time zones.',
	},
	{
		role: 'Technical Support and Administrator',
		org: 'FPS Gaming Solutions',
		dates: 'January 2009 – June 2011',
		description:
			'Provided technical support across hardware, software, and network environments. Responded to support tickets, troubleshot faults, maintained system records, prepared usage reports, and escalated issues where appropriate.',
	},
];

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Daniel Green',
	jobTitle: 'IT Support & Systems Professional',
	description:
		'Microsoft-certified (SC-900) IT Support & Systems Professional studying a BSc in Computing and IT with the Open University.',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Cambridge',
		addressCountry: 'GB',
	},
	sameAs: ['https://www.linkedin.com/in/danielgreen89'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="Daniel Green — IT Support & Systems Professional, CV and background." />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
		<style>
			.prompt {
				font-family: var(--font-mono);
				color: var(--accent);
				margin: 0 0 0.75em 0;
				font-size: 0.95em;
			}
			.cv-header h1 {
				margin-bottom: 0.2em;
			}
			.cv-role {
				color: rgb(var(--fg-muted));
				margin: 0 0 0.75em 0;
			}
			.cv-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em 1em;
				font-family: var(--font-mono);
				font-size: 0.85em;
				color: rgb(var(--fg-muted));
				margin-bottom: 2em;
			}
			.cv-meta a {
				color: rgb(var(--fg-muted));
				text-decoration: none;
			}
			.cv-meta a:hover {
				color: var(--accent);
			}
			section.cv-section {
				margin-bottom: 2.5em;
			}
			section.cv-section h2 {
				font-size: 1.1em;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
				border-bottom: 1px solid rgb(var(--border));
				padding-bottom: 0.5em;
				margin-bottom: 1em;
			}
			.skill-group {
				margin-bottom: 1em;
			}
			.skill-group:last-child {
				margin-bottom: 0;
			}
			.skill-group h3 {
				font-size: 0.95em;
				color: rgb(var(--fg-muted));
				margin-bottom: 0.6em;
				font-weight: normal;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.tags li {
				font-family: var(--font-mono);
				font-size: 0.85em;
				background: rgb(var(--bg-inset));
				border: 1px solid rgb(var(--border));
				border-radius: 4px;
				padding: 0.3em 0.6em;
				color: rgb(var(--fg));
			}
			.entry {
				margin-bottom: 1.75em;
			}
			.entry:last-child {
				margin-bottom: 0;
			}
			.entry-header {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.5em;
				margin-bottom: 0.3em;
			}
			.entry-title {
				margin: 0;
				font-size: 1.05em;
			}
			.entry-title a {
				color: rgb(var(--fg));
				text-decoration: none;
				border-bottom: 1px solid rgb(var(--border));
			}
			.entry-title a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}
			.entry-org {
				color: rgb(var(--fg-muted));
				font-weight: normal;
			}
			.entry-dates {
				font-family: var(--font-mono);
				font-size: 0.8em;
				color: rgb(var(--fg-muted));
				white-space: nowrap;
			}
			.entry p {
				margin: 0;
				color: rgb(var(--fg-muted));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="cv-header">
				<p class="prompt">mradder@web:~$ cat about.md</p>
				<h1>Daniel Green</h1>
				<p class="cv-role">IT Support &amp; Systems Professional · Microsoft Certified (SC-900) · BSc Computing &amp; IT Student</p>
				<div class="cv-meta">
					<span>Cambridge, UK</span>
					<a href="#" data-eu="30neergd" data-ed="moc.liamg" data-reveal="1">dgreen03 [at] gmail.com</a>
					<a href="https://www.linkedin.com/in/danielgreen89" target="_blank" rel="noopener noreferrer"
						>linkedin.com/in/danielgreen89</a
					>
				</div>
			</div>

			<section class="cv-section">
				<h2>Profile</h2>
				<p>
					Microsoft-certified IT professional with hands-on technical support experience and over
					seven years leading frontline operations in fast-paced retail environments. Holds the
					Microsoft Certified: Security, Compliance, and Identity Fundamentals (SC-900)
					certification and is studying part-time for a BSc (Hons) in Computing and IT with The
					Open University, achieving a Distinction in TM111.
				</p>
				<p>
					Brings practical skills from building and maintaining a Windows and Linux home lab,
					managing a UniFi network, and developing Node.js automation. Known for calm, structured
					troubleshooting under pressure, clear communication with non-technical users, and careful
					documentation. Since 2026, focused full-time on study and certification while seeking an
					entry-level IT Support, Service Desk, or Junior Systems Administrator role.
				</p>
			</section>

			<section class="cv-section">
				<h2>Core Skills</h2>
				{
					skills.map((group) => (
						<div class="skill-group">
							<h3>{group.label}</h3>
							<ul class="tags">
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</section>

			<section class="cv-section">
				<h2>Certifications</h2>
				<div class="entry">
					<div class="entry-header">
						<h3 class="entry-title">Microsoft Certified: Security, Compliance, and Identity Fundamentals (SC-900) <span class="entry-org">— Microsoft</span></h3>
						<span class="entry-dates">Issued January 2023</span>
					</div>
				</div>
			</section>

			<section class="cv-section">
				<h2>Education</h2>
				<div class="entry">
					<div class="entry-header">
						<h3 class="entry-title">BSc (Hons) Computing and IT (In Progress) <span class="entry-org">— The Open University</span></h3>
						<span class="entry-dates">April 2026 – April 2032 (expected)</span>
					</div>
					<p>
						TM111 Introduction to Computing and Information Technology 1: Distinction. Currently
						studying TM112 Introduction to Computing and Information Technology 2. Studying computing
						systems, operating systems, networking fundamentals, and software development through
						practical coursework and assessments.
					</p>
				</div>
			</section>

			<section class="cv-section">
				<h2>Technical Projects &amp; Independent Learning</h2>
				{
					projects.map((project) => (
						<div class="entry">
							<h3 class="entry-title">
								{project.href ? (
									<a href={project.href} target="_blank" rel="noopener noreferrer">
										{project.title}
									</a>
								) : (
									project.title
								)}
							</h3>
							<p>{project.description}</p>
						</div>
					))
				}
			</section>

			<section class="cv-section">
				<h2>Experience</h2>
				{
					experience.map((job) => (
						<div class="entry">
							<div class="entry-header">
								<h3 class="entry-title">
									{job.role} <span class="entry-org">— {job.org}</span>
								</h3>
								<span class="entry-dates">{job.dates}</span>
							</div>
							<p>{job.description}</p>
						</div>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
